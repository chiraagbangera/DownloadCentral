[Unit]
Description=Download Central unified downloader
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/download-central
EnvironmentFile=-/etc/download-central.env
Environment=PYTHONUNBUFFERED=1
Environment=STATE_DIR=/var/lib/download-central
ExecStart=/opt/download-central/.venv/bin/gunicorn --workers 1 --threads 12 --bind 0.0.0.0:100 --access-logfile - --error-logfile - wsgi:application
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

# TCP port 100 is privileged. The service stays unprivileged and receives only
# the capability needed to bind low ports.
AmbientCapabilities=CAP_NET_BIND_SERVICE

ProtectHome=true
PrivateDevices=true
PrivateTmp=false

# ProtectSystem, CapabilityBoundingSet, and NoNewPrivileges are intentionally
# not enabled: the two allowlisted sudo helper actions must schedule a service
# restart and update apt packages.
# The web process itself remains unprivileged and sudoers accepts only those
# exact fixed helper actions.

[Install]
WantedBy=multi-user.target
